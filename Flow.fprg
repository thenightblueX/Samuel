        <attribute name="edited" value="VGVjaEpvdmVtO0pPVkVNVEVDSDAwMDA5NzsyMDI2LTEwLTIyOyIwNToxOTo1MSAiOzE7MzE4MQ=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Inicio" type="String" array="False" size=""/>
            <input variable="Inicio"/>
            <if expression="Inicio == &quot;O dia ser&#225; bom?&quot;">
                <then>
                    <output expression="&quot;Sim&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;N&#227;o&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
    <function name="Media" type="None" variable="">
        <parameters/>
        <body>
            <declare name="nota1, nota2, media" type="Real" array="False" size=""/>
            <output expression="&quot;Informe a nota 1&quot;" newline="True"/>
            <input variable="nota1"/>
            <output expression="&quot;Informe nota 2&quot;" newline="True"/>
            <input variable="nota2"/>
            <assign variable="media" expression="(nota1+nota2)/2"/>
            <output expression="&quot;a nota media das notas &#233;:&quot; &amp; media" newline="True"/>
        </body>
    </function>
</flowgorithm>
